import { HorizontalBox, VerticalBox } from "std-widgets.slint";

// -----------------------------------------------------------------------
// Design tokens (section 10). Brand accent is green on near-black, per
// project spec. Dark variant only for Phase 0/1 — light/dark theme
// switching is deferred to Phase 5.
// -----------------------------------------------------------------------
global Tokens {
    out property <color> bg: #0b0d0a;
    out property <color> surface: #14170f;
    out property <color> text-primary: #f2f5ef;
    out property <color> text-muted: #8a9285;
    out property <color> accent: #3ab814;
    out property <color> accent-text: #0b0d0a;
    out property <color> divider: #23281c;
    out property <color> surface-sunken: #0f120d;
    out property <color> surface-hover: #1b2015;
    out property <color> text-dim: #5f655b;
    out property <color> accent-hover: #4acb22;
    out property <color> accent-dim: #1e510e;

    out property <length> radius: 8px;
    out property <length> button-height: 36px;
    out property <length> hit-min: 40px;
}

component KeyCap inherits Rectangle {
    in property <string> label;

    height: 20px;
    min-width: 22px;
    border-radius: 6px;
    background: Tokens.bg;
    border-width: 1px;
    border-color: Tokens.divider;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.label;
            color: Tokens.text-primary;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Round 36 px icon button (design 5.1). The TouchArea reaches 40 px via a
// 2 px unclipped overflow on every side, meeting the 40 px hit-area rule.
component IconButton inherits Rectangle {
    in property <int> icon: 0; // 0=wave 1=help
    callback clicked <=> area.clicked;

    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Tokens.divider;
    background: area.pressed ? Tokens.divider
        : area.has-hover ? Tokens.surface-hover : transparent;

    area := TouchArea {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
    }

    if root.icon == 0: Path {
        x: 6px;
        y: 6px;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: area.has-hover ? Tokens.text-primary : Tokens.text-muted;
        stroke-width: 1.8px;
        commands: "M 3 12 L 6 12 L 8 6 L 11 18 L 14 9 L 16 14 L 18 12 L 21 12";
    }
    if root.icon == 1: Text {
        text: "?";
        color: area.has-hover ? Tokens.text-primary : Tokens.text-muted;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }
}

// Transport glyph button (design 5.4/6): 44 px round with a 20 px fill
// glyph, or the 64 px accent play/pause circle with a 26 px glyph.
component GlyphButton inherits Rectangle {
    in property <int> icon: 0; // 0=prev 1=next 2=play 3=pause
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked <=> area.clicked;

    property <length> d: root.primary ? 64px : 44px;
    property <length> g: root.primary ? 26px : 20px;
    property <brush> glyph: root.primary && root.enabled ? Tokens.accent-text
        : root.primary ? Tokens.text-dim
        : root.enabled ? Tokens.text-primary : Tokens.text-dim;

    width: d;
    height: d;
    border-radius: d / 2;
    background: root.primary
        ? (!root.enabled ? Tokens.accent-dim
            : area.has-hover ? Tokens.accent-hover : Tokens.accent)
        : area.has-hover ? Tokens.surface-hover : transparent;

    area := TouchArea {
        enabled: root.enabled;
    }

    if root.icon == 0: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: g;
        height: g;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.glyph;
        commands: "M 5 5 L 7.6 5 L 7.6 19 L 5 19 Z M 19 6 L 19 18 L 9.5 12 Z";
    }
    if root.icon == 1: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: g;
        height: g;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.glyph;
        commands: "M 16.4 5 L 19 5 L 19 19 L 16.4 19 Z M 5 6 L 5 18 L 14.5 12 Z";
    }
    if root.icon == 2: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: g;
        height: g;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.glyph;
        commands: "M 8 5.5 L 8 18.5 L 19 12 Z";
    }
    if root.icon == 3: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: g;
        height: g;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.glyph;
        commands: "M 6.5 5 L 10.3 5 L 10.3 19 L 6.5 19 Z M 13.7 5 L 17.5 5 L 17.5 19 L 13.7 19 Z";
    }
}

// Text pill (design 5.4): 40 px tall, 48 min width, surface fill.
component PillButton inherits Rectangle {
    in property <string> label;
    callback clicked <=> area.clicked;

    height: 40px;
    min-width: 48px;
    border-radius: Tokens.radius;
    border-width: 1px;
    border-color: Tokens.divider;
    background: area.pressed ? Tokens.divider
        : area.has-hover ? Tokens.surface-hover : Tokens.surface;

    area := TouchArea { }

    Text {
        text: root.label;
        color: Tokens.text-primary;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }
}

// 14 px stroked folder glyph (design 6). Shared by the folder row and the
// empty-state card.
component FolderIcon inherits Path {
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: Tokens.text-muted;
    stroke-width: 1.6px;
    commands: "M 3 7 A 2 2 0 0 1 5 5 L 9 5 L 11 7 L 19 7 A 2 2 0 0 1 21 9 L 21 17 A 2 2 0 0 1 19 19 L 5 19 A 2 2 0 0 1 3 17 Z";
}

// Flat 36 px open button (design 5.1): surface fill, divider border,
// radius 8, 12 px text, 14 px side padding, 40 px hit area via overflow.
component OpenButton inherits Rectangle {
    in property <string> label;
    callback clicked <=> area.clicked;

    height: 36px;
    border-radius: Tokens.radius;
    border-width: 1px;
    border-color: Tokens.divider;
    background: area.pressed ? Tokens.divider
        : area.has-hover ? Tokens.surface-hover : Tokens.surface;

    area := TouchArea {
        y: -2px;
        width: 100%;
        height: 40px;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.label;
            color: Tokens.text-primary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One cell of the speed pill (design 5.5).
component SpeedCell inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked <=> area.clicked;

    width: 56px;
    height: 26px;
    border-radius: 13px;
    background: root.active ? Tokens.accent
        : area.pressed ? Tokens.divider
        : area.has-hover ? Tokens.surface-hover : transparent;

    area := TouchArea { }

    Text {
        text: root.label;
        color: root.active ? Tokens.accent-text
            : area.has-hover ? Tokens.text-primary : Tokens.text-muted;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }
}

// Flat fraction slider (spec 4.4): drag state is exposed via `dragging`,
// commit fires once on release (or click), and `enabled: false` (duration
// unknown) blocks all pointer events. Modeled on slint's own slider-base.
component SeekSlider inherits Rectangle {
    in property <float> fraction: 0.0;
    in property <bool> enabled: true;
    callback dragging(value-changed: bool);
    callback commit(value: float);

    private property <float> drag-value: 0.0;
    private property <bool> is-dragging: false;
    private property <float> shown: root.is-dragging ? root.drag-value : root.fraction;

    height: 24px;
    background: transparent;

    // Track: 6 px, centered, radius 3, divider
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        width: parent.width;
        height: 6px;
        border-radius: 3px;
        background: Tokens.divider;
    }

    // Fill: accent (accent-dim when disabled)
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        width: parent.width * root.shown;
        height: 6px;
        border-radius: 3px;
        background: root.enabled ? Tokens.accent : Tokens.accent-dim;
    }

    // Thumb: 14 px circle on the fill end, only while enabled
    if root.enabled: Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Tokens.text-primary;
        x: parent.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button != PointerEventButton.left) {
                    return;
                }
                root.is-dragging = true;
                root.drag-value = clamp(touch.mouse-x / max(root.width, 1px), 0.0, 1.0);
                root.dragging(true);
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-dragging) {
                    root.drag-value = clamp(touch.mouse-x / max(root.width, 1px), 0.0, 1.0);
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.is-dragging) {
                    if (event.kind == PointerEventKind.up) {
                        if (event.button != PointerEventButton.left) {
                            return;
                        }
                        root.drag-value = clamp(touch.mouse-x / max(root.width, 1px), 0.0, 1.0);
                    }
                    root.is-dragging = false;
                    root.dragging(false);
                    root.commit(root.drag-value);
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Q-pid";
    background: Tokens.bg;
    default-font-family: "Segoe UI Variable";

    preferred-width: 480px;
    preferred-height: 320px;
    min-width: 400px;
    min-height: 320px;

    forward-focus: keys;

    // ---- state exposed to Rust (ui.rs sets these; static defaults for Phase 0) ----
    in property <string> folder-name: "";
    in property <string> track-title: "";
    in property <int> track-index: 0;
    in property <int> track-count: 0;
    in property <string> elapsed-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> seek-fraction: 0.0;
    in property <bool> is-playing: false;
    in property <bool> has-track: false;
    in property <string> status-text: "";
    in property <int> speed-index: 1; // 0=0.5x 1=1x 2=1.25x 3=1.5x 4=2x
    in property <bool> seek-enabled: false;
    // Restore-from-minimize repaint trigger (ui.rs visibility sink): the
    // full-size overlay below reads it, so a bump marks the whole window
    // dirty and forces a complete redraw.
    in property <int> repaint-nonce: 0;

    // Help overlay: pure-slint state (button, backdrop and Esc all write it
    // directly) — no Rust wiring, no callback round-trip.
    property <bool> show-help: false;
    in property <string> help-version: "Q-pid";
    in property <string> help-media-note: "";

    // ---- commands to Rust (Phase 4 wires these; no-ops in Phase 0/1) ----
    callback open-file();
    callback open-folder();
    callback toggle-play();
    callback seek-back();
    callback seek-forward();
    callback next-track();
    callback prev-track();
    callback set-speed(int);
    callback seek-to(float);
    callback seek-dragging(value-changed: bool);
    callback step-speed(int);

    keys := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        // Spec 4.4 key map. Letters compare against both cases because
        // Shift changes event.text; arrow/space use the Key namespace.
        // Chords are checked first so Ctrl+N etc. never reach the plain
        // letter arms; everything else with a modifier is rejected.
        key-pressed(event) => {
            // Help overlay is modal: only Esc / ? / F1 pass (they close it).
            if (root.show-help) {
                if (event.text == Key.Escape || event.text == Key.F1 || event.text == "?") {
                    root.show-help = false;
                    return accept;
                }
                return reject;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                if (event.modifiers.shift) {
                    root.open-folder();
                } else {
                    root.open-file();
                }
                return accept;
            }
            if (event.text == Key.F1) { root.show-help = !root.show-help; return accept; }
            if (event.text == "?") { root.show-help = !root.show-help; return accept; }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.Space) { root.toggle-play(); return accept; }
            if (event.text == Key.LeftArrow) { root.seek-back(); return accept; }
            if (event.text == Key.RightArrow) { root.seek-forward(); return accept; }
            if (event.text == "n" || event.text == "N") { root.next-track(); return accept; }
            if (event.text == "p" || event.text == "P") { root.prev-track(); return accept; }
            if (event.text == "[") { root.step-speed(-1); return accept; }
            if (event.text == "]") { root.step-speed(1); return accept; }
            return reject;
        }

        VerticalBox {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            // Top row (design 5.1): open buttons left, help right.
            // 40px hit area, controls vertically centered in 36px visual.
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                alignment: start;

                OpenButton {
                    label: "Open file";
                    clicked => { root.open-file(); }
                }
                OpenButton {
                    label: "Open folder";
                    clicked => { root.open-folder(); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: 1;
                    clicked => { root.show-help = !root.show-help; }
                }
            }

            // Folder row (design 5.2): 14px icon + name, 16px tall.
            if root.has-track: HorizontalBox {
                padding: 0px;
                spacing: 6px;
                alignment: start;
                height: 16px;

                FolderIcon {
                    vertical-stretch: 0;
                }
                Text {
                    text: root.folder-name;
                    color: Tokens.text-muted;
                    font-size: 12px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            // Title row (design 5.2): title + counter pill, 28px.
            if root.has-track: HorizontalBox {
                padding: 0px;
                spacing: 8px;
                alignment: start;
                height: 28px;

                Text {
                    text: root.track-title;
                    color: Tokens.text-primary;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 18px;
                    border-radius: 999px;
                    border-width: 1px;
                    border-color: Tokens.divider;
                    background: Tokens.surface;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: root.track-index + " / " + root.track-count;
                            color: Tokens.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Empty state (design 5.6): 52px card replaces folder+title rows.
            if !root.has-track: Rectangle {
                height: 52px;
                background: Tokens.surface-sunken;
                border-width: 1px;
                border-color: Tokens.divider;
                border-radius: Tokens.radius;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    FolderIcon {
                        vertical-stretch: 0;
                    }
                    Text {
                        text: "Drop a folder or file here, or press Open";
                        color: Tokens.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            // Seek control (24px) full width + times row below (14px).
            VerticalBox {
                padding: 0px;
                spacing: 4px;

                SeekSlider {
                    height: 24px;
                    fraction: root.seek-fraction;
                    enabled: root.seek-enabled;
                    dragging(changed) => { root.seek-dragging(changed); }
                    commit(value) => { root.seek-to(value); }
                }
                HorizontalBox {
                    padding: 0px;
                    height: 14px;
                    Text {
                        text: root.elapsed-text;
                        color: Tokens.text-primary;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.duration-text;
                        color: Tokens.text-muted;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Transport row (design 5.4)
            HorizontalBox {
                padding: 0px;
                spacing: 10px;
                alignment: center;

                GlyphButton {
                    icon: 0;
                    enabled: root.has-track;
                    clicked => { root.prev-track(); }
                }
                PillButton { label: "-15"; clicked => { root.seek-back(); } }
                GlyphButton {
                    icon: root.is-playing ? 3 : 2;
                    primary: true;
                    enabled: root.has-track;
                    clicked => { root.toggle-play(); }
                }
                PillButton { label: "+15"; clicked => { root.seek-forward(); } }
                GlyphButton {
                    icon: 1;
                    enabled: root.has-track;
                    clicked => { root.next-track(); }
                }
            }

            // Speed pill row (design 5.5)
            HorizontalBox {
                padding: 0px;
                spacing: 4px;
                alignment: center;

                Rectangle {
                    width: 288px;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1px;
                    border-color: Tokens.divider;
                    background: Tokens.surface;

                    SpeedCell {
                        x: 4px;
                        y: 4px;
                        label: "0.5x";
                        active: root.speed-index == 0;
                        clicked => { root.set-speed(0); }
                    }
                    SpeedCell {
                        x: 60px;
                        y: 4px;
                        label: "1x";
                        active: root.speed-index == 1;
                        clicked => { root.set-speed(1); }
                    }
                    SpeedCell {
                        x: 116px;
                        y: 4px;
                        label: "1.25x";
                        active: root.speed-index == 2;
                        clicked => { root.set-speed(2); }
                    }
                    SpeedCell {
                        x: 172px;
                        y: 4px;
                        label: "1.5x";
                        active: root.speed-index == 3;
                        clicked => { root.set-speed(3); }
                    }
                    SpeedCell {
                        x: 228px;
                        y: 4px;
                        label: "2x";
                        active: root.speed-index == 4;
                        clicked => { root.set-speed(4); }
                    }
                }
            }

            // Status line (design 5.7): always reserved 14px.
            Text {
                text: root.status-text;
                color: Tokens.accent;
                font-size: 11px;
                height: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Help overlay: declared after the layout so it paints on top.
        // Backdrop click and Esc / ? / F1 close it; the panel swallows its
        // own clicks; while open the key handler rejects everything else.
        if root.show-help: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #00000099; // 60% dim over the window

            TouchArea { clicked => { root.show-help = false; } }

            Rectangle {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                background: Tokens.surface;
                border-width: 1px;
                border-color: Tokens.divider;
                border-radius: 8px;

                TouchArea { }

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    HorizontalBox {
                        padding: 0px;
                        height: 32px;
                        alignment: start;

                        Text {
                            text: "Keyboard";
                            color: Tokens.accent;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-area.pressed ? Tokens.divider
                                : close-area.has-hover ? Tokens.surface-hover : transparent;

                            close-area := TouchArea {
                                clicked => { root.show-help = false; }
                            }

                            Path {
                                x: (parent.width - 16px) / 2;
                                y: (parent.height - 16px) / 2;
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: close-area.has-hover ? Tokens.text-primary : Tokens.text-muted;
                                stroke-width: 1.8px;
                                commands: "M 6 6 L 18 18 M 18 6 L 6 18";
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        VerticalBox {
                            horizontal-stretch: 1;
                            padding: 0px;
                            spacing: 0px;

                            Text {
                                text: "Playback";
                                height: 18px;
                                color: Tokens.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "Space"; }
                                Text {
                                    text: "Play or pause";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "←"; }
                                KeyCap { label: "→"; }
                                Text {
                                    text: "Back or forward 15 s";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "N"; }
                                Text {
                                    text: "Next track";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "P"; }
                                Text {
                                    text: "Previous, or restart after 5 s";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Speed";
                                height: 18px;
                                color: Tokens.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "["; }
                                KeyCap { label: "]"; }
                                Text {
                                    text: "Slower or faster";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            padding: 0px;
                            spacing: 0px;

                            Text {
                                text: "Files";
                                height: 18px;
                                color: Tokens.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "Ctrl"; }
                                KeyCap { label: "O"; }
                                Text {
                                    text: "Open file";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "Ctrl"; }
                                KeyCap { label: "Shift"; }
                                KeyCap { label: "O"; }
                                Text {
                                    text: "Open folder";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "Drop"; }
                                Text {
                                    text: "File or folder";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { height: 12px; }
                            Text {
                                text: "View";
                                height: 18px;
                                color: Tokens.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "V"; }
                                Text {
                                    text: "Visualizer";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "?"; }
                                KeyCap { label: "F1"; }
                                Text {
                                    text: "Help";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                height: 22px;
                                spacing: 4px;
                                alignment: start;
                                KeyCap { label: "Esc"; }
                                Text {
                                    text: "Close";
                                    color: Tokens.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        height: 16px;
                        Text {
                            text: root.help-version + " PULSAR";
                            color: Tokens.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.help-media-note;
                            color: Tokens.text-muted;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // Full-window transparent overlay: its border-width reads
    // repaint-nonce, so bumping the nonce marks this full-size rect dirty
    // and the software renderer re-renders every item under it. Needed
    // because restore-from-minimize invalidates the window surface: the
    // restore-time draw presents too early (discarded by DWM) and later
    // partial updates (timer ticks) repaint only their own small regions,
    // leaving the rest of the window stale or blank.
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: root.repaint-nonce * 0px;
    }
}
